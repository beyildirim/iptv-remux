[Unit]
Description=IPTV live remux proxy (webOS 26 playback workaround)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/root/iptv-remux/iptv-remux.env
ExecStart=/usr/bin/python3 /root/iptv-remux/proxy.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
