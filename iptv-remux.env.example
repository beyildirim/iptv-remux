# Copy to iptv-remux.env (same dir as proxy.py on PVE) and fill in.
# Loaded by systemd (EnvironmentFile=) and refresh-playlist.sh.
# NEVER commit the real file — it holds provider credentials.

# Xtream-style live-stream URL template; {} is replaced with the channel id.
IPTV_PANEL_TEMPLATE=http://HOST:PORT/USERNAME/PASSWORD/{}

# Provider playlist (m3u_plus + ts output) used by refresh-playlist.sh.
IPTV_PLAYLIST_URL=http://HOST:PORT/get.php?username=USERNAME&password=PASSWORD&type=m3u_plus&output=ts
